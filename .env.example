# RAG Eval Studio - Environment Configuration
# API keys are completely optional if using "Precomputed Results" with "Quick" preset,
# or when using local Ollama.
# If provided here or entered directly into the UI, LiteLLM routes them to the chosen provider.

# OpenAI API Key (for gpt-4o, text-embedding-3-small, etc.)
# OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API Key (for claude-3-5-sonnet, claude-3-haiku, etc.)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Cohere API Key (for embed-english-v3.0, command-r, etc.)
# COHERE_API_KEY=your_cohere_api_key_here

# Local Ollama URL (Default: http://127.0.0.1:11434)
# OLLAMA_BASE_URL=http://127.0.0.1:11434

# Optional: Host/Port overrides if launching via custom server
# RAG_EVAL_HOST=127.0.0.1
# RAG_EVAL_PORT=7860
